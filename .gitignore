.env
node_modules/
.DS_Store
.vast/
corpus/
outputs/

# jobs/: text, code, and curated evidence are TRACKED (git is the memory organ
# — CLAUDE.md law 2026-08-18). Only bulk pixel intermediates stay out.
jobs/**
!jobs/**/
!jobs/**/*.md
!jobs/**/*.sh
!jobs/**/*.py
!jobs/**/*.mjs
!jobs/**/*.json
!jobs/**/*.html
!jobs/**/evidence*/**
!jobs/**/checkpoint-*/**
# cited in STATUS.md 2026-08-12 as the Phase-5 verdict evidence — must be in git
!jobs/sheen-inkwash/renders/contact-sheet.png
# wild-journey working set: everything pulled from the box is curated by
# construction (chain inputs, A/B clips, checkpoint renders) — track it all.
!jobs/wang-meng/journey/wild/**
# zone verdict evidence cited in STATE.md: keeper flights + control strips.
# Frame dumps (fly-*/, push-*/) stay out — the mp4 is the citable artifact.
!jobs/wang-meng/journey/z*/*.mp4
!jobs/wang-meng/journey/z*/evidence-*.png
!jobs/wang-meng/journey/z*/points-overlay.png
!jobs/wang-meng/journey/z*-rect-overlay.png
__pycache__/
!jobs/**/*.txt
!jobs/wang-meng/living/*.mp4
!jobs/wang-meng/living/inventory-overlay.png
!jobs/wang-meng/living/evidence-*.png
!jobs/wang-meng/living/native/*/mask-overlay.png
# THE CATALOGUE'S FOLIAGE MASKS ARE CONFIG, NOT INTERMEDIATES. regions.json
# names foliage-master.png as classes.foliage.leafMask, so a clone without it
# cannot build -- gates-must-survive-a-clone. They are ~250KB each (a binary
# mask compresses hard) and they encode four agents' labelling work, which is
# the expensive part of this repo and is NOT cheaply reproducible.
!jobs/wang-meng/catalogue/foliage-master*.png
!jobs/wang-meng/catalogue/sam*/*.png
!jobs/wang-meng/living/native/*/motion-heat.png
!jobs/wang-meng/living/native/*/vmin-compare.png
!jobs/wang-meng/film/*.mp4
!jobs/wang-meng/film/evidence-*.png

# Bulk renders. GitHub hard-rejects >100MB and these are regenerable outputs;
# the short A/B evidence clips (all <4MB) are what claims actually cite.
# Added 2026-08-20 after a push was rejected on a 329MB leg render.
jobs/wang-meng/film/SLOW-JOURNEY.mp4
# THE RISE, 2026-08-21: the assembled film is 168MB and each leg is 10-69MB.
# The film is the DELIVERABLE but not an archive: it is fully regenerable from
# film/build-rise.sh + film/paths/rise-*.json + the living layer, all of which
# ARE tracked. Ship it via ~/Desktop/WANG-MENG-LATEST.mp4, not via git.
jobs/wang-meng/film/THE-RISE.mp4
jobs/wang-meng/film/RISE-z*.mp4
jobs/wang-meng/film/leg-slow-*.mp4

# Bulk leg renders. GitHub hard-rejects >100MB, and these regenerate from the
# path JSON + layers in minutes. What the repo keeps is what claims cite: the
# A/B evidence clips, all under 4MB. Added 2026-08-20 after a rejected push.
jobs/wang-meng/film/SLOW-JOURNEY.mp4
# THE RISE, 2026-08-21: the assembled film is 168MB and each leg is 10-69MB.
# The film is the DELIVERABLE but not an archive: it is fully regenerable from
# film/build-rise.sh + film/paths/rise-*.json + the living layer, all of which
# ARE tracked. Ship it via ~/Desktop/WANG-MENG-LATEST.mp4, not via git.
jobs/wang-meng/film/THE-RISE.mp4
jobs/wang-meng/film/RISE-z*.mp4
jobs/wang-meng/film/leg-slow-*.mp4

# vision-model tiles: regenerable from the master by tools/tile-image.py
jobs/*/catalogue/tiles-*/*.jpg

# Derived plane stacks and measurement frame dirs from the 2026-08-24 fill and
# plane-count experiments. All are REPRODUCIBLE from committed tools:
#   layers-*-coarse4     journey/merge-planes.py + inpaint-planes
#   layers-filled-*      inpaint-planes --method <m>
#   measure-work/        journey/measure-invented.py (2.7GB of rendered frames)
# Track text, scripts, JSON and curated evidence; ignore bulk pixels.
jobs/*/journey/*/layers-*-coarse*/
jobs/*/journey/*/layers-filled-shiftmap/
jobs/*/journey/*/measure-work/

# living-work is the CUTTING FLOOR, not the record. Every png and preview in it
# is regenerated by build-zone-living.py from the catalogue plus regions.json,
# and it is 69MB on z1 alone. The cycle.json manifests ARE the record -- they
# name every card, its pivot and its phase -- so they stay tracked.
jobs/wang-meng/journey/*/living-work/**/*.png
jobs/wang-meng/journey/*/living-work/**/*.mp4
