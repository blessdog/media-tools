.env
node_modules/
.DS_Store
.vast/
corpus/
outputs/

# jobs/: text, code, and curated evidence are TRACKED (git is the memory organ
# — CLAUDE.md law 2026-08-18). Only bulk pixel intermediates stay out.
jobs/**
!jobs/**/
!jobs/**/*.md
!jobs/**/*.sh
!jobs/**/*.py
!jobs/**/*.mjs
!jobs/**/*.json
!jobs/**/*.html
!jobs/**/evidence*/**
!jobs/**/checkpoint-*/**
# cited in STATUS.md 2026-08-12 as the Phase-5 verdict evidence — must be in git
!jobs/sheen-inkwash/renders/contact-sheet.png
# wild-journey working set: everything pulled from the box is curated by
# construction (chain inputs, A/B clips, checkpoint renders) — track it all.
!jobs/wang-meng/journey/wild/**
# zone verdict evidence cited in STATE.md: keeper flights + control strips.
# Frame dumps (fly-*/, push-*/) stay out — the mp4 is the citable artifact.
!jobs/wang-meng/journey/z*/*.mp4
!jobs/wang-meng/journey/z*/evidence-*.png
!jobs/wang-meng/journey/z*/points-overlay.png
!jobs/wang-meng/journey/z*-rect-overlay.png
__pycache__/
!jobs/**/*.txt
!jobs/wang-meng/living/*.mp4
!jobs/wang-meng/living/inventory-overlay.png
!jobs/wang-meng/living/evidence-*.png
!jobs/wang-meng/living/native/*/mask-overlay.png
!jobs/wang-meng/living/native/*/motion-heat.png
!jobs/wang-meng/living/native/*/vmin-compare.png
!jobs/wang-meng/film/*.mp4
!jobs/wang-meng/film/evidence-*.png

# Bulk renders. GitHub hard-rejects >100MB and these are regenerable outputs;
# the short A/B evidence clips (all <4MB) are what claims actually cite.
# Added 2026-08-20 after a push was rejected on a 329MB leg render.
jobs/wang-meng/film/SLOW-JOURNEY.mp4
jobs/wang-meng/film/leg-slow-*.mp4
